# ============================================
# FOMO 交易监控 - 环境配置模板
# 把本文件复制为 .env 并填入真实值
#   Copy-Item .env.example .env
# ============================================

# ---------- Telegram 推送 ----------
# 1. Telegram 搜 @BotFather,发 /newbot 创建
# 2. 给 Bot 发一条消息,访问 https://api.telegram.org/bot<TOKEN>/getUpdates 拿 chat_id
FOMO_TELEGRAM_BOT_TOKEN=
FOMO_TELEGRAM_CHAT_ID=

# 只有这个 chat_id 发的命令才会被执行(防止别人拉走你的 Bot 乱加人)
# 留空则默认等于 FOMO_TELEGRAM_CHAT_ID
FOMO_TELEGRAM_ADMIN_CHAT_ID=

# ---------- FOMO 平台 ----------
# 登录态由 `--login` 生成,存在 data/fomo_session.json,不需要在这里填任何凭据。
# 本项目只读 FOMO 接口,不做任何交易操作。

# API 客户端实现: http(curl_cffi 直连,轻量) / playwright(页面上下文,兜底)
# 先跑 --probe 确认 http 能过 Cloudflare;不通再改成 playwright
FOMO_CLIENT_IMPL=http

# ---------- 轮询 ----------
# 轮询间隔(秒)。20s 是延迟与 API 压力的平衡点
FOMO_POLL_INTERVAL_SEC=20
# /add 新用户时回填多少条历史 swaps 用于建立"首次买入"判定基线
FOMO_BACKFILL_MAX_ITEMS=500
# 推送间隔(秒),规避 Telegram 同 chat 限流(约 20 msg/min)
FOMO_SEND_INTERVAL_SEC=3.5

# ---------- 网络 ----------
# 代理(国内访问 fomo.family / Telegram 通常需要),例: http://127.0.0.1:7897
# 留空则不走代理
FOMO_PROXY=

# ---------- 日志 ----------
LOG_LEVEL=INFO
