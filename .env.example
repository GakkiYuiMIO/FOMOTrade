# ============================================
# FOMO 交易监控 - 环境配置模板
# 把本文件复制为 .env 并填入真实值
#   Copy-Item .env.example .env
# ============================================

# ---------- Telegram 推送 ----------
# 1. Telegram 搜 @BotFather,发 /newbot 创建
# 2. 给 Bot 发一条消息,访问 https://api.telegram.org/bot<TOKEN>/getUpdates 拿 chat_id
FOMO_TELEGRAM_BOT_TOKEN=
FOMO_TELEGRAM_CHAT_ID=

# 只有这个 chat_id 发的命令才会被执行(防止别人拉走你的 Bot 乱加人)
# 留空则默认等于 FOMO_TELEGRAM_CHAT_ID
FOMO_TELEGRAM_ADMIN_CHAT_ID=

# ---------- FOMO 平台 ----------
# 登录态由 `--login` 生成,存在 data/fomo_session.json,不需要在这里填任何凭据。
# 本项目只读 FOMO 接口,不做任何交易操作。

# API 客户端实现: http(curl_cffi 直连,轻量) / playwright(页面上下文,兜底)
# 先跑 --probe 确认 http 能过 Cloudflare;不通再改成 playwright
FOMO_CLIENT_IMPL=http

# ---------- 轮询 ----------
# 轮询间隔(秒)。上游健康时单轮约 2-3s,端到端 ≈ 间隔/2 + 单轮 ≈ 10s。
# ⚠️ 别贴着单轮耗时设:FOMO 的 /balances 会周期性劣化(实测从 p50 1.2s 掉到单次 10s),
#    那时单轮会涨到 11-13s。间隔设成 10 就会一直刷 'skipped ... max instances'
#    (数据不会丢,但看着像故障)。15 在两种情况下都够用。
FOMO_POLL_INTERVAL_SEC=15
# /add 新用户时回填多少条历史 swaps 用于建立"首次买入"判定基线
FOMO_BACKFILL_MAX_ITEMS=500
# 推送**稳态**间隔(秒/条)。突发 5 条以内立刻发完,再多才按这个速率匀速
FOMO_SEND_INTERVAL_SEC=1.5

# ---------- 网页版 ----------
# 网页版端口(仅本机访问,`bot.ps1 --web` 用)
FOMO_WEB_PORT=8420

# ---------- 网络 ----------
# 代理(国内访问 fomo.family / Telegram 通常需要),例: http://127.0.0.1:7897
# 留空则不走代理
FOMO_PROXY=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# 拉取并发线程数。调度单元是一个请求,不是一个用户。
# 实测拐点很明确:12 线程 15.1s、24 线程 10.8s,但 36 线程反而掉到 66.6s
# —— 服务端/代理打满之后只会换来 504 和重试风暴。
# ⚠️ 观点扫描的后台线程与它同时在打,真实峰值 = 本值 + 4,调大时按和算
FOMO_FETCH_WORKERS=12

# 距上一轮超过这么久(分钟)就认定中间停过机:
# 本轮事件照常入库,但不逐条推送、改发一条汇总。
# 适合"白天开机跑、晚上关机"的用法 —— 否则开机时几百条积压会一次性喷出来。
# 45 分钟比正常轮询间隔大两个量级,不会被网络抖动误触发;睡一觉起来必然命中。
# 设 0 关闭该行为。
FOMO_CATCHUP_THRESHOLD_MIN=45

# ---------- 转入告警(「N 个名单成员收到同一个币」) ----------
# 「收到」= 从外部钱包转入,不是在 FOMO 上买 —— 往往是项目方在分发筹码。
# 几个人收到才告警。实测(本地库 19 天真实数据回放,金额门槛 $500):
#   2 人 -> 约 5.0 条/天    3 人 -> 约 2.8 条/天    5 人 -> 约 1.4 条/天
FOMO_TRANSFER_ALERT_RECEIVERS=3
# 统计窗口(小时),与买入信号保持一致
FOMO_TRANSFER_ALERT_WINDOW_HOURS=24
# 单人到账金额下限(美元),低于此不计入人数。
# ⚠️ 这是这个功能能不能上线的分水岭:不设门槛 138.8 次/天(会被直接静音),
#    $100 -> 10.1,$500 -> 6.0,$1000 -> 4.0。噪音几乎全是空投灰尘和平台级批量发放。
#    再往上会把真信号一起筛掉(实测最低那笔真信号是 $901.37)。
FOMO_TRANSFER_ALERT_MIN_USD=500

# ---------- 币安 Alpha 新上架推送 ----------
# 币安 Alpha 全量名单里出现新代币就推一条 Telegram。
# 用的是币安**公开免登录**接口,不需要任何 API Key,也永远不会下单 —— 只推通知。
# ⚠️ 第一次启动只会静默记下"当前最新的上架时间"作为水位线,一条都不推;
#    否则名单里 600 多个币全会被当成新的,把 Telegram 打爆。
FOMO_ALPHA_ENABLED=true

# 巡检间隔(秒)。实测上新约 3~4 天一个(近 7 天 2 个、近 30 天 8 个),
# 不需要快;打太勤只是白挨币安风控。
FOMO_ALPHA_INTERVAL_SEC=300

# 板块标注:命中的币会在推送里多一行「🏷 板块 · XXX」。
# 格式 rankType:tabId:显示名,多个用逗号分隔;留空 = 不标注。
# 默认 60:61 是 App 钱包页「市場焦點」里的「股票 Meme 幣」。
# ⚠️ 这个目录是币安运营编排的、没有任何文档,随时可能改名或下线 ——
#    所以它只是一行标注:拿不到就整行消失,主干的上新推送照发。
FOMO_ALPHA_SECTORS=60:61:股票 Meme 幣

# ---------- pump.fun 指定用户买卖监控 ----------
# 被 /pump add 点名的人在 pump.fun 上成交,就逐笔推一条 Telegram
# (签名 / 时刻 / 方向 / 单价 / 金额都来自 pump.fun 的公开逐笔成交接口)。
# 用的是 pump.fun **公开免登录**接口,不需要任何 API Key、不登录、也永远不会下单。
# ⚠️ 默认 false(与币安 Alpha 刻意不同):这是新功能,老库升级后行为必须不变,
#    要用就自己打开,再用 /pump add <名字或钱包> 把人加进来(名单空 = 一个请求都不打)。
# ⚠️ 每个人被加进来后的**第一轮只记下当前持仓、一条都不推** ——
#    否则一个有 1905 个持仓的人会把 Telegram 打爆。
FOMO_PUMP_ENABLED=false

# 巡检间隔(秒)。持仓变动是小时级事件,不需要快;打太勤只是白挨 pump 的限流
# (portfolio 端点 60 次/分)。下限 30s。
FOMO_PUMP_INTERVAL_SEC=60

# 单笔成交的美元门槛,低于此不推。
# ⚠️ 与 FOMO_TRANSFER_WATCH_MIN_USD 是两个功能的两个门槛,互不相干。
# ⚠️ 实测 pump.fun 逐笔里存在 $0.0000028 这种粉尘级成交,不设门槛会被灰尘刷屏。
FOMO_PUMP_MIN_USD=50

# 单轮最多处理多少个「变动的 mint」。
# ⚠️ 这是请求预算的闸:变动的 mint 数 = 本轮的额外请求数。
#    超限的部分本轮不处理,下一轮还会被重新选中,信息不丢、只是慢一轮。
FOMO_PUMP_MAX_MINTS=8

# 成交的新鲜窗口(秒)。只推这个窗口之内的成交。
# ⚠️ 必须有:逐笔接口返回的是这个人在这个币上的**一段历史**,不是"刚刚那笔"。
#    没有窗口的话,一个持有半年的币今天动一下,半年前的成交会被整段推出来。
# ⚠️ 代价:进程停机超过这个窗口再启动,停机期间的成交不会补推(快照照常前移)。
#    这是刻意的 —— 停机一天之后收到几百条隔夜成交,用户会当场静音。
FOMO_PUMP_TRADE_MAX_AGE_SEC=7200
