# ==================================================
# 敏感配置 —— 绝不提交
# ==================================================
.env
.env.local
*.key
*.pem

# FOMO 登录态与原始数据(含 Privy refresh token / 账号信息,泄漏 = 账号被接管)
data/fomo_session.json
data/*_session.json
data/fomo_probe/
playwright_profile/

# ==================================================
# 数据 / 日志
# ==================================================
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
logs/
*.log

# ==================================================
# Python
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ==================================================
# IDE / 系统
# ==================================================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ==================================================
# Poetry
# ==================================================
poetry.lock
.superpowers/

# 仓库根目录的散落数据库副本。
# 子代理调试时会在这里留下 fomo_copy.db 之类的文件,而 data/*.db 那几条挡不住根目录。
# 一旦被 git add -A 带进历史,等于把整个名单数据写进仓库,事后极难清干净。
/*.db
/*.db-wal
/*.db-shm
/*.db-journal
